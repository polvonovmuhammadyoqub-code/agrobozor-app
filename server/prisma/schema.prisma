// AgroBozor Prisma Schema
datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String   @id @default(uuid())
  phone               String   @unique
  email               String?  @unique
  password_hash       String
  full_name           String
  role                String   // 'FARMER', 'BUYER_B2C', 'BUYER_B2B', 'COURIER', 'ADMIN'
  region              String   // Viloyat / tuman
  tin_or_passport     String   // STIR yoki pasport seriyasi
  farm_or_company_name String? // Fermer yoki kompaniya nomi
  kyc_status          String   @default("PENDING") // 'PENDING', 'APPROVED', 'REJECTED'
  is_premium          Boolean  @default(false)
  wallet_available    Int    @default(0) // Yechib olish mumkin bo'lgan balans
  wallet_escrow       Int    @default(0) // Muzlatilgan / kutilayotgan balans
  rating              Float    @default(5.0)
  created_at          DateTime @default(now())

  // Phase-1: yangi maydonlar (barchasi nullable yoki default bilan)
  telegram_chat_id    String?
  language            String   @default("uz")
  is_online           Boolean  @default(false)  // kuryer uchun
  vehicle_type        String?  // MOTO, CAR, VAN, COLD_VAN
  district            String?

  // Relations
  products            Product[]      @relation("FarmerProducts")
  buyer_orders        Order[]        @relation("BuyerOrders")
  farmer_orders       Order[]        @relation("FarmerOrders")
  courier_orders      Order[]        @relation("CourierOrders")
  transactions        Transaction[]
  disputes            Dispute[]
  reviews_given       Review[]       @relation("Reviewer")
  reviews_received    Review[]       @relation("ReviewTarget")
  notifications       Notification[]
  audit_logs          AuditLog[]
}

model Product {
  id                    String   @id @default(uuid())
  farmer_id             String
  title                 String
  category              String   // 'MEVALAR', 'SABZAVOTLAR', 'POLIZ', 'SUT_GOSHT', 'DON'
  price_per_kg          Int      // tanlangan birlikdagi narx (nom tarixiy, aslida «narx per birlik»)
  available_quantity_kg Float    // tanlangan birlikdagi mavjud miqdor
  min_order_kg          Float    @default(1) // tanlangan birlikdagi minimal buyurtma
  harvest_date          DateTime
  image_url             String
  region                String
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())

  // Phase-1: yangi maydonlar
  unit                  String   @default("KG") // KG, DONA, LITR, BANKA, QUTI
  image_urls            String[] @default([])   // ko'p rasmlar; birinchisi image_url bilan sinxron
  pickup_district       String?
  pickup_address        String?
  pickup_lat            Float?
  pickup_lng            Float?
  pickup_window         String?  // masalan "06:00–09:00"

  @@index([is_active, category])

  // Relations
  farmer                User     @relation("FarmerProducts", fields: [farmer_id], references: [id], onDelete: Cascade)
  orders                Order[]
}

model Order {
  id                        String        @id @default(uuid())
  buyer_id                  String
  farmer_id                 String
  courier_id                String?
  product_id                String
  quantity_kg               Float         // tanlangan birlikdagi miqdor
  product_total_amount      Int
  delivery_fee              Int         @default(15000)
  total_paid                Int
  platform_commission       Int         // product_total_amount * 0.10
  farmer_payout             Int         // product_total_amount * 0.90
  courier_payout            Int         @default(12000)
  platform_logistics_margin Int         @default(3000)
  payment_method            String        // 'CLICK', 'PAYME', 'UZCARD', 'HUMO', 'INVOICE_B2B'
  status                    String        // 'PENDING_PAYMENT', 'PAID_IN_ESCROW', 'CANCELLED', 'CONFIRMED_BY_FARMER', 'IN_TRANSIT', 'DELIVERED', 'COMPLETED', 'DISPUTED', 'REFUNDED'
  delivery_address          String
  delivery_schedule         String?       // B2B doimiy jadval, masalan "Dushanba, Payshanba"
  created_at                DateTime      @default(now())
  delivered_at              DateTime?

  // Phase-1: yangi maydonlar
  delivery_pin              String?
  delivery_pin_attempts     Int           @default(0)
  delivery_district         String?
  delivery_lat              Float?
  delivery_lng              Float?
  paid_at                   DateTime?
  confirmed_at              DateTime?
  picked_up_at              DateTime?

  // Relations
  buyer                     User          @relation("BuyerOrders", fields: [buyer_id], references: [id])
  farmer                    User          @relation("FarmerOrders", fields: [farmer_id], references: [id])
  courier                   User?         @relation("CourierOrders", fields: [courier_id], references: [id])
  product                   Product       @relation(fields: [product_id], references: [id])
  transactions              Transaction[]
  dispute                   Dispute?
  reviews                   Review[]
  notifications             Notification[]
  audit_logs                AuditLog[]
}

model Transaction {
  id          String   @id @default(uuid())
  order_id    String?
  user_id     String
  amount      Int
  type        String   // 'ESCROW_HOLD', 'ESCROW_RELEASE_FARMER', 'PLATFORM_COMMISSION', 'COURIER_FEE', 'REFUND', 'PREMIUM_SUBSCRIPTION'
  created_at  DateTime @default(now())

  // Relations
  order       Order?   @relation(fields: [order_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])
}

model Dispute {
  id                 String   @id @default(uuid())
  order_id           String   @unique
  buyer_id           String
  reason             String
  evidence_image_url String?
  status             String   @default("OPEN") // 'OPEN', 'RESOLVED_REFUND_FULL', 'RESOLVED_REFUND_PARTIAL', 'RESOLVED_FARMER_WIN'
  refund_amount      Int?
  admin_comment      String?
  created_at         DateTime @default(now())

  // Relations
  order              Order    @relation(fields: [order_id], references: [id])
  buyer              User     @relation(fields: [buyer_id], references: [id])
}

model Notification {
  id         String    @id @default(uuid())
  user_id    String
  kind       String    // xabar turi: ORDER_PAID, FARMER_CONFIRMED, DELIVERED va h.k.
  title      String
  body       String
  order_id   String?
  read_at    DateTime?
  created_at DateTime  @default(now())

  // Relations
  user       User      @relation(fields: [user_id], references: [id])
  order      Order?    @relation(fields: [order_id], references: [id])

  @@index([user_id, created_at])
}

model Review {
  id             String   @id @default(uuid())
  order_id       String
  reviewer_id    String
  target_user_id String
  rating         Int
  comment        String
  created_at     DateTime @default(now())

  // Relations
  order          Order    @relation(fields: [order_id], references: [id])
  reviewer       User     @relation("Reviewer", fields: [reviewer_id], references: [id])
  target_user    User     @relation("ReviewTarget", fields: [target_user_id], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  actor_id   String
  action     String   // 'ORDER_DELIVER_OVERRIDE', 'ORDER_RESET_PIN', etc.
  order_id   String?
  reason     String?
  created_at DateTime @default(now())

  // Relations
  actor      User     @relation(fields: [actor_id], references: [id])
  order      Order?   @relation(fields: [order_id], references: [id])

  @@index([actor_id, created_at])
  @@index([order_id, created_at])
}

model EmailVerification {
  id         String   @id @default(uuid())
  email      String
  code       String
  expires_at DateTime
  attempts   Int      @default(0)
  created_at DateTime @default(now())

  @@index([email])
}
