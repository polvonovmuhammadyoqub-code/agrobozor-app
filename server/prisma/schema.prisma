// AgroBozor Prisma Schema
datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String   @id @default(uuid())
  phone               String   @unique
  email               String?  @unique
  password_hash       String
  full_name           String
  role                String   // 'FARMER', 'BUYER_B2C', 'BUYER_B2B', 'COURIER', 'ADMIN'
  region              String   // Viloyat / tuman
  tin_or_passport     String   // STIR yoki pasport seriyasi
  farm_or_company_name String? // Fermer yoki kompaniya nomi
  kyc_status          String   @default("PENDING") // 'PENDING', 'APPROVED', 'REJECTED'
  is_premium          Boolean  @default(false)
  wallet_available    Int    @default(0) // Yechib olish mumkin bo'lgan balans
  wallet_escrow       Int    @default(0) // Muzlatilgan / kutilayotgan balans
  rating              Float    @default(5.0)
  created_at          DateTime @default(now())

  // Relations
  product_views       ProductView[]
  conversations_started Conversation[] @relation("ConversationBuyer")
  conversations_received Conversation[] @relation("ConversationSeller")
  messages_sent       Message[]
  products            Product[]      @relation("FarmerProducts")
  buyer_orders        Order[]        @relation("BuyerOrders")
  farmer_orders       Order[]        @relation("FarmerOrders")
  courier_orders      Order[]        @relation("CourierOrders")
  transactions        Transaction[]
  withdrawals         WithdrawalRequest[]
  disputes            Dispute[]
  reviews_given       Review[]       @relation("Reviewer")
  reviews_received    Review[]       @relation("ReviewTarget")
}

model Product {
  id                    String   @id @default(uuid())
  farmer_id             String
  title                 String
  category              String   // 'MEVALAR', 'SABZAVOTLAR', 'POLIZ', 'SUT_GOSHT', 'DON'
  price_per_kg          Int
  available_quantity_kg Float
  min_order_kg          Float    @default(1)
  harvest_date          DateTime
  image_url             String
  region                String
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())

  @@index([is_active, category])

  // Relations
  farmer                User     @relation("FarmerProducts", fields: [farmer_id], references: [id], onDelete: Cascade)
  orders                Order[]
  views                 ProductView[]
  conversations         Conversation[]
}

model Order {
  id                        String        @id @default(uuid())
  buyer_id                  String
  farmer_id                 String
  courier_id                String?
  product_id                String
  product_title             String?
  unit_price_per_kg         Int?
  quantity_kg               Float
  product_total_amount      Int
  delivery_fee              Int         @default(15000)
  total_paid                Int
  platform_commission       Int         // product_total_amount * 0.10
  farmer_payout             Int         // product_total_amount * 0.90
  courier_payout            Int         @default(12000)
  platform_logistics_margin Int         @default(3000)
  payment_method            String        // 'CLICK', 'PAYME', 'UZCARD', 'HUMO', 'INVOICE_B2B'
  status                    String        // 'PENDING_PAYMENT', 'PAID_IN_ESCROW', 'CANCELLED', 'CONFIRMED_BY_FARMER', 'IN_TRANSIT', 'DELIVERED', 'COMPLETED', 'DISPUTED', 'REFUNDED'
  delivery_address          String
  delivery_schedule         String?       // B2B doimiy jadval, masalan "Dushanba, Payshanba"
  created_at                DateTime      @default(now())
  delivered_at              DateTime?

  // Relations
  buyer                     User          @relation("BuyerOrders", fields: [buyer_id], references: [id])
  farmer                    User          @relation("FarmerOrders", fields: [farmer_id], references: [id])
  courier                   User?         @relation("CourierOrders", fields: [courier_id], references: [id])
  product                   Product       @relation(fields: [product_id], references: [id])
  transactions              Transaction[]
  dispute                   Dispute?
  reviews                   Review[]
}

model Transaction {
  id          String   @id @default(uuid())
  order_id    String?
  user_id     String
  amount      Int
  type        String   // 'ESCROW_HOLD', 'ESCROW_RELEASE_FARMER', 'PLATFORM_COMMISSION', 'COURIER_FEE', 'REFUND', 'PREMIUM_SUBSCRIPTION'
  created_at  DateTime @default(now())

  // Relations
  order       Order?   @relation(fields: [order_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])
}

model Dispute {
  id                 String   @id @default(uuid())
  order_id           String   @unique
  buyer_id           String
  reason             String
  evidence_image_url String?
  status             String   @default("OPEN") // 'OPEN', 'RESOLVED_REFUND_FULL', 'RESOLVED_REFUND_PARTIAL', 'RESOLVED_FARMER_WIN'
  refund_amount      Int?
  admin_comment      String?
  created_at         DateTime @default(now())

  // Relations
  order              Order    @relation(fields: [order_id], references: [id])
  buyer              User     @relation(fields: [buyer_id], references: [id])
}

model Review {
  @@unique([order_id, reviewer_id, target_user_id])

  id             String   @id @default(uuid())
  order_id       String
  reviewer_id    String
  target_user_id String
  rating         Int
  comment        String
  created_at     DateTime @default(now())

  // Relations
  order          Order    @relation(fields: [order_id], references: [id])
  reviewer       User     @relation("Reviewer", fields: [reviewer_id], references: [id])
  target_user    User     @relation("ReviewTarget", fields: [target_user_id], references: [id])
}

model EmailVerification {
  id         String   @id @default(uuid())
  email      String
  code       String
  expires_at DateTime
  attempts   Int      @default(0)
  created_at DateTime @default(now())

  @@index([email])
}

model WithdrawalRequest {
  id             String    @id @default(uuid())
  user_id        String
  amount         Int
  card_number    String
  status         String    @default("PENDING") // 'PENDING', 'PAID', 'REJECTED'
  admin_comment  String?
  created_at     DateTime  @default(now())
  processed_at   DateTime?

  // Relations
  user           User      @relation(fields: [user_id], references: [id])
}

model ProductView {
  id             String   @id @default(uuid())
  product_id     String
  viewer_id      String
  first_viewed_at DateTime @default(now())
  last_viewed_at  DateTime @default(now())
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  viewer         User     @relation(fields: [viewer_id], references: [id], onDelete: Cascade)

  @@unique([product_id, viewer_id])
  @@index([product_id, last_viewed_at])
}

model Conversation {
  id         String   @id @default(uuid())
  product_id String
  buyer_id   String
  seller_id  String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  product    Product  @relation(fields: [product_id], references: [id])
  buyer      User     @relation("ConversationBuyer", fields: [buyer_id], references: [id])
  seller     User     @relation("ConversationSeller", fields: [seller_id], references: [id])
  messages   Message[]

  @@unique([product_id, buyer_id, seller_id])
  @@index([buyer_id, updated_at])
  @@index([seller_id, updated_at])
}

model Message {
  id              String   @id @default(uuid())
  client_id       String   @unique
  conversation_id String
  sender_id       String
  body            String
  created_at      DateTime @default(now())
  read_at         DateTime?
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender          User     @relation(fields: [sender_id], references: [id])

  @@index([conversation_id, created_at, id])
}
