# --- MAJBURIY ---
# PostgreSQL (Neon yoki Supabase). SQLite Vercel'da ishlamaydi.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Kamida 32 belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# --- Email tasdiqlash (resend.com) ---
RESEND_API_KEY=""
EMAIL_FROM="AgroBozor <noreply@sizning-domeningiz.uz>"

# --- Ixtiyoriy ---
PORT=5000
# To'lov rejimi: mock (test, haqiqiy pul YO'Q) | disabled (production'da standart)
PAYMENT_MODE=mock
# Fermer/kuryerni admin tekshiruvisiz tasdiqlash (faqat demo/pilot!)
AUTO_APPROVE_KYC=false
# Email sozlanmaganda kodni ekranda ko'rsatish (faqat staging!)
ALLOW_DEV_CODES=false
# Frontend boshqa domenda bo'lsagina: https://sizning-sayt.uz
CORS_ORIGIN=""
