# --- MAJBURIY ---
# PostgreSQL (Neon yoki Supabase). SQLite Vercel'da ishlamaydi.
# Supabase: Project > Connect. DATABASE_URL = "Transaction pooler" (port 6543) + ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.xxxx:PAROL@aws-0-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = "Session pooler" yoki "Direct connection" (port 5432) — jadval yaratish uchun
DIRECT_URL="postgresql://postgres.xxxx:PAROL@aws-0-xxx.pooler.supabase.com:5432/postgres"
# Kamida 32 belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# --- Email tasdiqlash (resend.com) ---
RESEND_API_KEY=""
EMAIL_FROM="AgroBozor <noreply@sizning-domeningiz.uz>"

# --- Ixtiyoriy ---
PORT=5000
# direct = fermerga qo‘lda to‘lov (standart); mock = sinov; disabled = checkout yopiq; payme = merchant
PAYMENT_MODE=direct
# Fermer/kuryerni admin tekshiruvisiz tasdiqlash (faqat demo/pilot!)
AUTO_APPROVE_KYC=false
# Email sozlanmaganda kodni ekranda ko'rsatish (faqat staging!)
ALLOW_DEV_CODES=false
# Frontend boshqa domenda bo'lsagina: https://sizning-sayt.uz
CORS_ORIGIN=""

# Payme Merchant API (faqat shartnoma va sandbox tekshiruvidan keyin).
# PAYMENT_MODE=payme
PAYME_MERCHANT_ID=""
PAYME_KEY=""
PAYME_SANDBOX=true
# Ilovaning haqiqiy HTTPS manzili. Maxfiy kalitlar frontendga kiritilmaydi.
APP_URL=""
# Payme kabinetidagi endpoint: https://domeningiz/api/payments/payme
# account maydoni: order_id (String). Sandbox uchun TEST_KEY, jonli rejim uchun key.
