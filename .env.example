# Node.js 22+; rootdan npm ci --include=dev, npm run build, npm start.
NODE_ENV=production
# Hosting PORT bersa shu ishlatiladi; uni hostingda majburan 5000 qilmang.
PORT=5000
HOST=0.0.0.0
# Reverse proxy soni: bevosita serverda 0; bitta ishonchli hosting proxy ortida 1.
TRUST_PROXY=0

# PostgreSQL: runtime uchun pooled ulanish; migratsiya uchun direct/session ulanish.
# Bir xil bazaga yo'naltiring. Paroldagi maxsus belgilarni URL-encode qiling.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Kamida 32 tasodifiy belgi. Masalan: openssl rand -hex 48
JWT_SECRET=""

# Dastlab faqat direct: xaridor fermerga to'laydi, fermer tasdiqlaydi.
# Platforma pul qabul qilmaydi va escrow kafolati bermaydi.
# disabled=checkout yopiq; mock=faqat test; payme=merchant sozlangandan keyin.
PAYMENT_MODE=direct
AUTO_APPROVE_KYC=false
# Productionda false: tasdiqlash kodini javobda oshkor qilmang.
ALLOW_DEV_CODES=false
# Ishlaydigan email tasdiqlash uchun resend.com kaliti va tasdiqlangan domen kerak.
RESEND_API_KEY=""
EMAIL_FROM="AgroBozor <noreply@example.uz>"
# Saytning tashqi HTTPS manzili (oxirida / siz).
APP_URL="https://example.uz"
# Frontend shu Node serverdan xizmat qiladi: bo'sh qolishi mumkin.
# Alohida frontend bo'lsa ruxsat etilgan originlar vergul bilan ajratiladi.
CORS_ORIGIN=""

# Supabase Storage: product-images public, private-docs private.
# docs/storage-buckets.sql va docs/HOSTING.md ga qarang.
# Service role faqat serverda! VITE_ prefiksida yoki browser kodida ishlatmang.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Ixtiyoriy Payme: hozir bo'sh qoldiring; direct rejimda faol emas.
# Endpoint https://example.uz/api/payments/payme; account.order_id String.
# Merchant shartnomasi va haqiqiy sandbox sinovisiz PAYMENT_MODE ni almashtirmang.
PAYME_MERCHANT_ID=""
PAYME_KEY=""
PAYME_SANDBOX=true

# Adminni bir marta yaratishda vaqtincha kiriting, keyin olib tashlang.
ADMIN_PHONE=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Faqat alohida test bazasi. Production URL'ini hech qachon yozmang.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agrobozor_test"
# Browser test uchun ixtiyoriy lokal Chromium yo'li:
# CHROMIUM_PATH=/usr/bin/chromium
