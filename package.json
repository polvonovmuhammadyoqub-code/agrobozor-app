{
  "name": "agrobozooor",
  "version": "1.0.0",
  "description": "AgroBozor - O'zbekistonning Ishonchli Agro-Savdo Platformasi",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/dist/index.js",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build": "npm run db:push && npm run build:server && npm run build:client",
    "db:push": "prisma db push --schema server/prisma/schema.prisma --skip-generate",
    "create-admin": "npm run create-admin --prefix server",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "keywords": [
    "agro",
    "ecommerce",
    "escrow",
    "uzbekistan"
  ],
  "author": "AgroBozor Team",
  "license": "ISC"
}
